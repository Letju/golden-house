digraph mcd {
  rankdir=TB; nodesep=0.45; ranksep=0.75; splines=spline;
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [arrowhead=vee, arrowsize=0.9, penwidth=1.4];

  fournisseurs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#148246" COLSPAN="2"><FONT COLOR="white"><B>fournisseurs</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>nom</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>email</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>telephone</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>adresse</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR></TABLE>>];
  notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#0C7378" COLSPAN="2"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>titre</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>message</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>type</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">notification_type_enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>est_lu</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean</FONT></TD></TR></TABLE>>];
  products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#148246" COLSPAN="2"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>nom</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>description</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>prix</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>categorie</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">product_category_enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>type_matiere</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">material_type_enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>couleur</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>largeur_cm</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>hauteur_cm</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>profondeur_cm</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>stock</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>seuil_alerte</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>images</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fournisseur_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>est_actif</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">boolean</FONT></TD></TR></TABLE>>];
  reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#0C7378" COLSPAN="2"><FONT COLOR="white"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>product_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>titre</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>description</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>note</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>reponse_commercant</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>repondu_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">timestamptz</FONT></TD></TR></TABLE>>];
  supply_order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#148246" COLSPAN="2"><FONT COLOR="white"><B>supply_order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>supply_order_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>product_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>quantite</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>prix_unitaire</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD></TR></TABLE>>];
  supply_orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#148246" COLSPAN="2"><FONT COLOR="white"><B>supply_orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fournisseur_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>statut</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">supply_order_status_enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>montant_total</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>date_emission</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>date_reception</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">timestamptz</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#BBBBBB"><FONT COLOR="white"><B>users</B></FONT></TD></TR></TABLE>>];

  notifications -> users [color="#093F43"];
  products -> fournisseurs [color="#0E5C31"];
  reviews -> products [color="#093F43"];
  reviews -> users [color="#093F43"];
  supply_order_items -> products [color="#0E5C31"];
  supply_order_items -> supply_orders [color="#0E5C31"];
  supply_orders -> fournisseurs [color="#0E5C31"];
}
